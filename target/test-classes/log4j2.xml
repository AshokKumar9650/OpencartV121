<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

<properties>
      <property name="basePath">./logs</property>     <!-- Variable declarartion using property-->
</properties>

  <Appenders>
  
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    
    <RollingFile name = "File" fileName="${basePath}/automation.log" filePattern="${basePath}/automation-%d{yyyy-MM-dd}.log">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
       <SizeBasedTriggeringPolicy size="5000"/>
    </RollingFile>
    
    
  </Appenders>
  
  
  
  <Loggers>                                    <!--  This will control the appenders - where to get logs -->
    <Root level="Info">         <!--  This where log level is set  -->
      <AppenderRef ref="File"/>  <!--  This where Console/File is set  -->
    </Root>
  </Loggers>
</Configuration>